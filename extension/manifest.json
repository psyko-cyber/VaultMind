{
  "manifest_version": 3,
  "name": "VaultMind",
  "version": "0.1.0",
  "description": "Finestra sul tuo VaultMind locale: cerca e copia le credenziali dall'app. Sola lettura, nessun dato salvato nel browser.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VaultMind"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8731/*"]
}
