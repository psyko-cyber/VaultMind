# Python
.venv/
venv/
__pycache__/
*.pyc

# Build PyInstaller (.exe)
build/
dist/
*.spec

# Dati utente: il vault cifrato vive in ~/.vaultmind/, mai nel repo
vault.json
settings.json
*.vaultmind-backup

# Consegnabili: binari rigenerabili dal codice, inutili in git.
# I due file di istruzioni invece restano tracciati, cosi' la cartella non
# sparisce dal repo e chi lo clona sa cosa ci va dentro.
Consegnabili/*.zip
Consegnabili/*.exe
Consegnabili/*.apk

# Installer compilato (installer/build-installer.ps1): rigenerabile, ~100 MB
installer/Output/

# Sistema
.DS_Store
Thumbs.db
*.tmp
