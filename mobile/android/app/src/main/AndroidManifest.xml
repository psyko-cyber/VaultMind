<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Serve al sync sulla rete locale, e va dichiarato QUI.

         Il template di Flutter mette INTERNET solo in `src/debug/` e
         `src/profile/`, dove serve al hot reload: l'APK di rilascio nasce
         quindi senza rete, e nessun socket si apre. Il guasto non si vede
         nemmeno, perche' l'app e' scritta per non lamentarsi quando la rete
         non c'e' (`Annunciatore.avvia()` torna false in silenzio, la ricerca
         non trova niente): identico a un router che isola i dispositivi. Con
         l'APK di debug il sync funzionava, con quello vero no.

         Niente permessi di rete oltre a questo: VaultMind non chiama Internet,
         parla solo con l'altro dispositivo in casa.

         (Nel testo di questo commento niente doppi trattini: l'XML li vieta,
         e il manifest smette di essere leggibile. Gia' pagata.) -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Serve a inquadrare il QR di attivazione della 2FA, e a nient'altro.

         Android lo chiede all'utente al primo uso, non all'installazione: chi
         non usa mai quella schermata non vede mai la domanda.

         `required="false"`: un telefono senza fotocamera posteriore deve poter
         installare l'app lo stesso. Il QR si legge anche da uno screenshot, e
         quella strada non passa di qui. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="VaultMind"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/nessun_backup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- "Apri con VaultMind" direttamente dall'allegato in chat.
                 È la ragione per cui l'utente non deve mettersi a frugare fra
                 le cartelle del telefono per ritrovare il backup: tocca il
                 file in WhatsApp, sceglie VaultMind, e il ripristino parte. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="text/json"/>
            </intent-filter>
            <!-- Alcune app condividono i documenti invece di aprirli. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/json"/>
            </intent-filter>
        </activity>

        <!-- Il lettore di QR.

             `exported="false"`: la lancia solo VaultMind. Un'altra app non
             deve poter aprire la nostra fotocamera, e nemmeno farsi leggere un
             QR da noi.

             Bloccata in verticale di proposito: si inquadra un QR in due
             secondi, e permettere la rotazione vuol dire ricostruire
             l'anteprima nel mezzo del gesto per guadagnare niente.

             Stesso tema di avvio della schermata principale, cosi' il passaggio
             non lampeggia di bianco. -->
        <activity
            android:name=".ScansionaQr"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/NormalTheme"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
