<?xml version="1.0" encoding="utf-8"?>
<!-- Lo splash di Android prima del 12. Stesso aspetto di values-v31: il
     medaglione sul fondo del tema, cosi' la prima schermata di Flutter parte
     dallo stesso colore invece che da un lampo bianco. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/sfondo_icona" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
